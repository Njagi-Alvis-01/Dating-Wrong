rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          (request.auth.token.email != null &&
           request.auth.token.email_verified == true && (
            request.auth.token.email == 'alvisnjagi@gmail.com' ||
            request.auth.token.email == 'wanyekigerison@gmail.com' ||
            request.auth.token.email == 'ochiengmark2908@gmail.com'
          )) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Client can update profile fields; role change restricted to admin
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isAdmin();
      allow delete: if isAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      // User can read their own payment records, Admin can read all
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      // Client can only create pending checkout requests; status verification happens on backend
      allow create: if isAuthenticated() && 
        request.resource.data.uid == request.auth.uid;
      // Only backend or admin can verify, complete, or update payment statuses
      allow update, delete: if isAdmin();
    }

    // Payment Requests Collection (M-PESA Pochi pasted SMS verification requests)
    match /paymentRequests/{requestId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      // User creates pending verification request with their attached Google UID
      allow create: if isAuthenticated() && 
        request.resource.data.uid == request.auth.uid;
      // Only administrators can approve or reject payment requests
      allow update, delete: if isAdmin();
    }

    // Book Entitlements Collection (indexed by uid_bookId)
    match /bookEntitlements/{entitlementDocId} {
      allow get: if isAuthenticated() && (
        entitlementDocId.matches('^' + request.auth.uid + '.*') ||
        (resource != null && (
          resource.data.uid == request.auth.uid ||
          (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
          (resource.data.email != null && resource.data.email == request.auth.token.email)
        )) ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Entitlements Collection (client sync & query by userId/email)
    match /entitlements/{entitlementId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Used Transactions (Transaction uniqueness protection)
    match /usedTransactions/{transactionCode} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Devices Collection (Section 29: Authorized Offline Devices)
    match /devices/{deviceId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
    }

    // Reading Progress Collection (uid_bookId)
    match /readingProgress/{progressId} {
      allow get: if isAuthenticated() && (
        progressId.matches('^' + request.auth.uid + '_.*') ||
        (resource != null && resource.data.uid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        (progressId.matches('^' + request.auth.uid + '_.*') &&
         request.resource.data.uid == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Bookmarks Collection (uid_bookId)
    match /bookmarks/{bookmarkId} {
      allow get: if isAuthenticated() && (
        bookmarkId.matches('^' + request.auth.uid + '_.*') ||
        (resource != null && resource.data.uid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow create, update: if isAuthenticated() && (
        (bookmarkId.matches('^' + request.auth.uid + '_.*') &&
         request.resource.data.uid == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Access Tickets Collection (Single-use cryptographic nonces, hashed by SHA-256)
    match /accessTickets/{tokenHash} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (
        isAuthenticated() &&
        resource != null &&
        resource.data.type == 'customer_reader' &&
        resource.data.targetEmail == request.auth.token.email
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource != null &&
        resource.data.type == 'customer_reader' &&
        resource.data.targetEmail == request.auth.token.email &&
        resource.data.isConsumed == false &&
        request.resource.data.isConsumed == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isConsumed', 'consumedAt', 'consumedByEmail', 'consumedByUid'])
      );
    }

    // Offline Licenses Collection (Cryptographically signed offline leases)
    match /offlineLicenses/{licenseId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Config Collection (Book price, Paybill, Merchant details)
    match /config/{configId} {
      allow read: if true; // Publicly readable for dynamic pricing display
      allow write: if isAdmin();
    }

    // Admin Logs (Audit logs)
    match /adminAlertLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /customerEmailLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Real-Time Admin Action Broadcast & Multi-Device Sync Stream
    match /adminActions/{actionId} {
      allow read, write: if isAdmin();
    }
  }
}
